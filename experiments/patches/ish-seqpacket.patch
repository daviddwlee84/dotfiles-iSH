diff --git a/fs/seqpacket.c b/fs/seqpacket.c
new file mode 100644
index 0000000..572f628
--- /dev/null
+++ b/fs/seqpacket.c
@@ -0,0 +1,773 @@
+/* Experimental AF_UNIX record transport. Host AF_UNIX SOCK_SEQPACKET is
+ * unavailable on Darwin, so all records and ancillary ownership live here.
+ * This deliberately does not claim Linux completeness: cyclic socket rights
+ * need a UNIX-domain garbage collector before this can be upstream-ready. */
+#include <limits.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <time.h>
+#include "kernel/calls.h"
+#include "kernel/fs.h"
+#include "fs/poll.h"
+#include "fs/path.h"
+#include "fs/seqpacket.h"
+
+#define SP_MAX_PACKET (1024 * 1024)
+#define SP_DEFAULT_BUFFER 212992
+#define SP_MAX_RIGHTS 253
+#define SP_MAX_IOV 1024
+#define SP_NOSIGNAL 0x4000
+#define SP_CMSG_CLOEXEC 0x40000000
+#define SP_PASSCRED 16
+#define SP_CREDENTIALS 2
+#define SP_ACCEPTCONN 30
+#define SP_RCVTIMEO_OLD 20
+#define SP_SNDTIMEO_OLD 21
+#define SP_FIONREAD 0x541b
+#define SP_POLL_RDHUP 0x2000
+
+struct sp_record {
+    struct list link;
+    size_t length;
+    unsigned num_rights;
+    struct fd *rights[SP_MAX_RIGHTS];
+    struct ucred_ cred;
+    char bytes[];
+};
+struct seqpacket {
+    struct fd *owner;
+    struct fd *peer; /* weak; protected by sp_lock, close clears it */
+    struct list records, pending, pending_link, bound_link;
+    bool connected, listening, read_shutdown, write_shutdown;
+    bool abstract, bound, passcred;
+    unsigned backlog, pending_count, sndbuf, rcvbuf;
+    int pending_error;
+    struct timespec receive_timeout, send_timeout;
+    size_t sent_bytes;
+    uint32_t path_id;
+    struct ucred_ peer_cred;
+    unsigned peer_name_len;
+    char peer_name[108];
+    atomic_int readiness;
+};
+static lock_t sp_lock = LOCK_INITIALIZER;
+static struct list sp_bound = LIST_INITIALIZER(sp_bound);
+static cond_t sp_changed = COND_INITIALIZER;
+
+/* poll() must not acquire sp_lock: poll_wakeup is called with it held, and
+ * the generic poll implementation calls us while holding its own lock. */
+static void sp_update(struct fd *fd) {
+    struct seqpacket *sp = fd->socket.seqpacket;
+    int ready = 0;
+    if (sp->listening) {
+        if (sp->pending_count || sp->read_shutdown) ready |= POLL_READ;
+        if (sp->read_shutdown && sp->write_shutdown) ready |= POLL_HUP;
+    } else if (sp->connected) {
+        struct seqpacket *peer = sp->peer ? sp->peer->socket.seqpacket : NULL;
+        bool eof = !peer || peer->write_shutdown || sp->read_shutdown;
+        if (!list_empty(&sp->records) || eof) ready |= POLL_READ;
+        if (eof) ready |= SP_POLL_RDHUP;
+        if (sp->pending_error) ready |= POLL_ERR;
+        if (!peer || (eof && (sp->write_shutdown || peer->read_shutdown))) ready |= POLL_HUP;
+        if (!peer || sp->write_shutdown || peer->read_shutdown || sp->sent_bytes < sp->sndbuf)
+            ready |= POLL_WRITE;
+    } else {
+        ready = POLL_WRITE | POLL_HUP;
+    }
+    int previous = atomic_exchange(&sp->readiness, ready);
+    if (ready != previous) poll_wakeup(fd, ready & ~previous);
+    notify(&fd->cond);
+}
+
+/* wait_for takes a relative duration; recompute it after every wakeup so
+ * repeated signals or queue activity cannot extend a configured deadline. */
+static struct timespec sp_deadline(struct timespec timeout) {
+    if (!timeout.tv_sec && !timeout.tv_nsec) return (struct timespec) {0};
+    struct timespec end; clock_gettime(CLOCK_MONOTONIC, &end);
+    end.tv_sec += timeout.tv_sec; end.tv_nsec += timeout.tv_nsec;
+    if (end.tv_nsec >= 1000000000) { end.tv_sec++; end.tv_nsec -= 1000000000; }
+    return end;
+}
+static int sp_wait(cond_t *cond, struct timespec end) {
+    struct timespec remaining, *timeout = NULL;
+    if (end.tv_sec || end.tv_nsec) {
+        struct timespec now; clock_gettime(CLOCK_MONOTONIC, &now);
+        remaining.tv_sec = end.tv_sec - now.tv_sec;
+        remaining.tv_nsec = end.tv_nsec - now.tv_nsec;
+        if (remaining.tv_nsec < 0) { remaining.tv_sec--; remaining.tv_nsec += 1000000000; }
+        if (remaining.tv_sec < 0) return _EAGAIN;
+        timeout = &remaining;
+    }
+    int err = wait_for(cond, &sp_lock, timeout);
+    return err == _ETIMEDOUT ? _EAGAIN : err;
+}
+
+static struct ucred_ sp_current_cred(void) {
+    return (struct ucred_) { current->tgid, current->euid, current->egid };
+}
+
+static struct fd *sp_create(void) {
+    struct fd *fd = adhoc_fd_create(&seqpacket_fdops);
+    if (!fd) return NULL;
+    struct seqpacket *sp = calloc(1, sizeof(*sp));
+    if (!sp) { fd->ops = &(const struct fd_ops) {}; fd_close(fd); return NULL; }
+    fd->socket.seqpacket = sp;
+    fd->socket.domain = AF_LOCAL_;
+    fd->socket.type = SOCK_SEQPACKET_;
+    fd->socket.unix_cred = sp_current_cred();
+    fd->stat.mode = S_IFSOCK | 0777;
+    fd->stat.uid = current->euid;
+    fd->stat.gid = current->egid;
+    fd->real_fd = -1;
+    sp->owner = fd;
+    sp->sndbuf = sp->rcvbuf = SP_DEFAULT_BUFFER;
+    sp->peer_cred = (struct ucred_) { 0, (uid_t_) -1, (uid_t_) -1 };
+    list_init(&sp->records);
+    list_init(&sp->pending);
+    atomic_init(&sp->readiness, POLL_WRITE | POLL_HUP);
+    return fd;
+}
+
+static int sp_type_valid(int type, int protocol) {
+    if (type & ~(SOCK_SEQPACKET_ | SOCK_CLOEXEC_ | SOCK_NONBLOCK_)) return _EINVAL;
+    if (protocol) return _EPROTONOSUPPORT;
+    return 0;
+}
+fd_t seqpacket_socket(int type, int protocol) {
+    int err = sp_type_valid(type, protocol);
+    if (err) return err;
+    struct fd *fd = sp_create();
+    return fd ? f_install(fd, type & (SOCK_CLOEXEC_ | SOCK_NONBLOCK_)) : _ENOMEM;
+}
+
+static void sp_link(struct fd *a, struct fd *b) {
+    struct seqpacket *sa = a->socket.seqpacket, *sb = b->socket.seqpacket;
+    sa->peer = b; sb->peer = a;
+    sa->connected = sb->connected = true;
+    sa->peer_cred = b->socket.unix_cred;
+    sb->peer_cred = a->socket.unix_cred;
+    sa->peer_name_len = b->socket.unix_name_len;
+    sb->peer_name_len = a->socket.unix_name_len;
+    memcpy(sa->peer_name, b->socket.unix_name, sa->peer_name_len);
+    memcpy(sb->peer_name, a->socket.unix_name, sb->peer_name_len);
+    sp_update(a); sp_update(b);
+}
+int_t seqpacket_pair(int type, int protocol, addr_t result) {
+    int err = sp_type_valid(type, protocol);
+    if (err) return err;
+    struct fd *a = sp_create(), *b = sp_create();
+    if (!a || !b) {
+        if (a) fd_close(a);
+        if (b) fd_close(b);
+        return _ENOMEM;
+    }
+    lock(&sp_lock); sp_link(a, b); unlock(&sp_lock);
+    fd_t fds[2];
+    fds[0] = f_install(a, type);
+    if (fds[0] < 0) { fd_close(b); return fds[0]; }
+    fds[1] = f_install(b, type);
+    if (fds[1] < 0) { f_close(fds[0]); return fds[1]; }
+    if (user_write(result, fds, sizeof(fds))) {
+        f_close(fds[0]); f_close(fds[1]); return _EFAULT;
+    }
+    return 0;
+}
+
+struct sp_name { uint16_t family; char bytes[108]; };
+static int sp_read_name(addr_t addr, unsigned len, struct sp_name *name, unsigned *size) {
+    if (len <= 2 || len > sizeof(*name)) return _EINVAL;
+    memset(name, 0, sizeof(*name));
+    if (user_read(addr, name, len)) return _EFAULT;
+    if (name->family != AF_LOCAL_) return _EAFNOSUPPORT;
+    *size = len - 2;
+    if (name->bytes[0]) {
+        size_t n = strnlen(name->bytes, *size);
+        if (n == 108) return _ENAMETOOLONG;
+        *size = n + 1;
+        name->bytes[n] = 0;
+    }
+    return 0;
+}
+static struct fd *sp_find(const struct sp_name *name, unsigned len, uint32_t path_id) {
+    struct seqpacket *sp;
+    list_for_each_entry(&sp_bound, sp, bound_link) {
+        if (name->bytes[0] && !sp->abstract && sp->path_id == path_id)
+            return sp->owner;
+        if (!name->bytes[0] && sp->abstract && sp->owner->socket.unix_name_len == len &&
+                !memcmp(name->bytes, sp->owner->socket.unix_name, len))
+            return sp->owner;
+    }
+    return NULL;
+}
+int_t seqpacket_bind(struct fd *fd, addr_t addr, uint_t len) {
+    struct sp_name name; unsigned size;
+    int err = sp_read_name(addr, len, &name, &size);
+    if (err) return err;
+    lock(&fd->lock);
+    struct seqpacket *sp = fd->socket.seqpacket;
+    if (sp->bound) { unlock(&fd->lock); return _EINVAL; }
+    uint32_t path_id = 0;
+    if (name.bytes[0]) {
+        char normalized[MAX_PATH];
+        err = path_normalize(AT_PWD, name.bytes, normalized, N_SYMLINK_FOLLOW | N_PARENT_DIR_WRITE);
+        if (err) { unlock(&fd->lock); return err; }
+        err = unix_socket_get(name.bytes, fd, &path_id);
+        if (err) { unlock(&fd->lock); return err; }
+    }
+    lock(&sp_lock);
+    if (sp_find(&name, size, path_id)) {
+        err = _EADDRINUSE;
+    } else {
+        sp->bound = true;
+        sp->abstract = !name.bytes[0];
+        sp->path_id = path_id;
+        fd->socket.unix_name_len = size;
+        memcpy(fd->socket.unix_name, name.bytes, size);
+        list_add_tail(&sp_bound, &sp->bound_link);
+    }
+    unlock(&sp_lock); unlock(&fd->lock);
+    return err;
+}
+int_t seqpacket_listen(struct fd *fd, int_t backlog) {
+    struct seqpacket *sp = fd->socket.seqpacket;
+    lock(&sp_lock);
+    int err = 0;
+    if (!sp->bound) err = _EINVAL;
+    else if (sp->connected) err = _EINVAL;
+    else {
+        sp->listening = true; sp->backlog = backlog < 0 ? 128 : backlog;
+        fd->socket.unix_cred = sp_current_cred();
+        sp_update(fd); notify(&sp_changed);
+    }
+    unlock(&sp_lock);
+    return err;
+}
+int_t seqpacket_connect(struct fd *fd, addr_t addr, uint_t len) {
+    struct sp_name name; unsigned size;
+    int err = sp_read_name(addr, len, &name, &size);
+    if (err) return err;
+    uint32_t path_id = 0;
+    if (name.bytes[0]) {
+        err = generic_accessat(AT_PWD, name.bytes, AC_W);
+        if (err) return err;
+        err = unix_socket_get(name.bytes, NULL, &path_id);
+        if (err) return err;
+    }
+    struct fd *accepted = sp_create();
+    if (!accepted) return _ENOMEM;
+    lock(&sp_lock);
+    struct seqpacket *sp = fd->socket.seqpacket;
+    struct timespec deadline = sp_deadline(sp->send_timeout);
+    while (true) {
+        if (sp->connected) { err = _EISCONN; break; }
+        if (sp->listening) { err = _EINVAL; break; }
+        struct fd *server = sp_find(&name, size, path_id);
+        if (!server || !server->socket.seqpacket->listening || server->socket.seqpacket->read_shutdown) { err = _ECONNREFUSED; break; }
+        struct seqpacket *listener = server->socket.seqpacket;
+        if (listener->pending_count > listener->backlog) {
+            if (fd->flags & O_NONBLOCK_) { err = _EAGAIN; break; }
+            err = sp_wait(&sp_changed, deadline);
+            if (err) break;
+            continue;
+        }
+        accepted->socket.unix_name_len = server->socket.unix_name_len;
+        memcpy(accepted->socket.unix_name, server->socket.unix_name, server->socket.unix_name_len);
+        accepted->socket.unix_cred = server->socket.unix_cred;
+        struct seqpacket *child = accepted->socket.seqpacket;
+        child->passcred = listener->passcred;
+        child->sndbuf = listener->sndbuf; child->rcvbuf = listener->rcvbuf;
+        child->send_timeout = listener->send_timeout;
+        child->receive_timeout = listener->receive_timeout;
+        fd->socket.unix_cred = sp_current_cred();
+        sp_link(fd, accepted);
+        list_add_tail(&listener->pending, &accepted->socket.seqpacket->pending_link);
+        listener->pending_count++;
+        sp_update(server);
+        accepted = NULL;
+        err = 0;
+        break;
+    }
+    unlock(&sp_lock);
+    if (accepted) fd_close(accepted);
+    return err;
+}
+static int sp_write_name(const char *name, unsigned len, addr_t addr, addr_t len_addr) {
+    dword_t capacity;
+    if (user_get(len_addr, capacity)) return _EFAULT;
+    struct sp_name value = { .family = AF_LOCAL_ };
+    memcpy(value.bytes, name, len);
+    unsigned actual = 2 + len;
+    if (user_write(addr, &value, capacity < actual ? capacity : actual) || user_put(len_addr, actual))
+        return _EFAULT;
+    return 0;
+}
+int_t seqpacket_name(struct fd *fd, addr_t addr, addr_t len_addr, bool peer) {
+    struct seqpacket *sp = fd->socket.seqpacket;
+    char name[108]; unsigned len;
+    lock(&sp_lock);
+    if (peer && !sp->connected) { unlock(&sp_lock); return _ENOTCONN; }
+    len = peer ? sp->peer_name_len : fd->socket.unix_name_len;
+    memcpy(name, peer ? sp->peer_name : fd->socket.unix_name, len);
+    unlock(&sp_lock);
+    return sp_write_name(name, len, addr, len_addr);
+}
+int_t seqpacket_accept(struct fd *fd, addr_t addr, addr_t len_addr, int flags) {
+    struct seqpacket *sp = fd->socket.seqpacket;
+    lock(&sp_lock);
+    if (!sp->listening) { unlock(&sp_lock); return _EINVAL; }
+    struct timespec deadline = sp_deadline(sp->receive_timeout);
+    while (list_empty(&sp->pending)) {
+        if (sp->read_shutdown) { unlock(&sp_lock); return _EINVAL; }
+        if (fd->flags & O_NONBLOCK_) { unlock(&sp_lock); return _EAGAIN; }
+        int err = sp_wait(&fd->cond, deadline);
+        if (err) { unlock(&sp_lock); return err; }
+    }
+    struct seqpacket *child = list_first_entry(&sp->pending, struct seqpacket, pending_link);
+    list_remove(&child->pending_link); sp->pending_count--; sp_update(fd); notify(&sp_changed);
+    struct fd *accepted = child->owner;
+    unlock(&sp_lock);
+    if (addr) {
+        int err = seqpacket_name(accepted, addr, len_addr, true);
+        if (err) { fd_close(accepted); return err; }
+    }
+    return f_install(accepted, flags);
+}
+
+static void sp_record_free(struct sp_record *record) {
+    for (unsigned i = 0; i < record->num_rights; i++)
+        if (record->rights[i]) fd_close(record->rights[i]);
+    free(record);
+}
+static struct sp_record *sp_record_new(size_t length) {
+    if (length > SP_MAX_PACKET) return NULL;
+    struct sp_record *record = calloc(1, sizeof(*record) + length);
+    if (record) { record->length = length; record->cred = sp_current_cred(); }
+    return record;
+}
+static size_t sp_charge(struct sp_record *record) { return record->length + 128; }
+static int sp_send_record(struct fd *fd, struct sp_record *record, int flags) {
+    struct seqpacket *sp = fd->socket.seqpacket;
+    int err = 0;
+    if (flags & MSG_OOB_) return _EOPNOTSUPP;
+    lock(&sp_lock);
+    struct timespec deadline = sp_deadline(sp->send_timeout);
+    if (sp->pending_error) {
+        err = sp->pending_error; sp->pending_error = 0; sp_update(fd); goto out;
+    }
+    if (record->length + 32 > sp->sndbuf) { err = _EMSGSIZE; goto out; }
+    while (true) {
+        if (!sp->connected || sp->listening) { err = _ENOTCONN; break; }
+        struct seqpacket *peer = sp->peer ? sp->peer->socket.seqpacket : NULL;
+        if (!peer || sp->write_shutdown || peer->read_shutdown) { err = _EPIPE; break; }
+        if (sp->sent_bytes >= sp->sndbuf) {
+            if ((fd->flags & O_NONBLOCK_) || (flags & MSG_DONTWAIT_)) { err = _EAGAIN; break; }
+            err = sp_wait(&fd->cond, deadline);
+            if (err) break;
+            continue;
+        }
+        list_add_tail(&peer->records, &record->link);
+        sp->sent_bytes += sp_charge(record);
+        sp_update(fd); sp_update(sp->peer);
+        err = record->length;
+        break;
+    }
+out:
+    unlock(&sp_lock);
+    return err;
+}
+/* Successful calls own a snapshot; peek retains the original queue entry. */
+static int sp_take_record(struct fd *fd, int flags, struct sp_record **out) {
+    struct seqpacket *sp = fd->socket.seqpacket;
+    *out = NULL;
+    if (flags & MSG_OOB_) return _EOPNOTSUPP;
+    lock(&sp_lock);
+    struct timespec deadline = sp_deadline(sp->receive_timeout);
+    if (sp->pending_error) {
+        int err = sp->pending_error; sp->pending_error = 0; sp_update(fd);
+        unlock(&sp_lock); return err;
+    }
+    while (list_empty(&sp->records)) {
+        if (!sp->connected || sp->listening) { unlock(&sp_lock); return _ENOTCONN; }
+        if (sp->pending_error) {
+            int err = sp->pending_error; sp->pending_error = 0; sp_update(fd);
+            unlock(&sp_lock); return err;
+        }
+        if (!sp->peer || sp->read_shutdown || sp->peer->socket.seqpacket->write_shutdown) {
+            unlock(&sp_lock); return 0;
+        }
+        if ((fd->flags & O_NONBLOCK_) || (flags & MSG_DONTWAIT_)) {
+            unlock(&sp_lock); return _EAGAIN;
+        }
+        int err = sp_wait(&fd->cond, deadline);
+        if (err) { unlock(&sp_lock); return err; }
+    }
+    struct sp_record *record = list_first_entry(&sp->records, struct sp_record, link);
+    if (flags & MSG_PEEK_) {
+        *out = malloc(sizeof(*record) + record->length);
+        if (!*out) { unlock(&sp_lock); return _ENOMEM; }
+        memcpy(*out, record, sizeof(*record) + record->length);
+        for (unsigned i = 0; i < record->num_rights; i++) fd_retain((*out)->rights[i]);
+    } else {
+        list_remove(&record->link);
+        if (sp->peer) {
+            sp->peer->socket.seqpacket->sent_bytes -= sp_charge(record);
+            sp_update(sp->peer);
+        }
+        sp_update(fd);
+        *out = record;
+    }
+    unlock(&sp_lock);
+    return 0;
+}
+static ssize_t sp_read(struct fd *fd, void *buffer, size_t len) {
+    if (!len) return 0;
+    struct sp_record *record;
+    int err = sp_take_record(fd, 0, &record);
+    if (err || !record) return err;
+    size_t copied = len < record->length ? len : record->length;
+    memcpy(buffer, record->bytes, copied);
+    sp_record_free(record);
+    return copied;
+}
+static ssize_t sp_write(struct fd *fd, const void *buffer, size_t len) {
+    if (len > SP_MAX_PACKET) return _EMSGSIZE;
+    struct sp_record *record = sp_record_new(len);
+    if (!record) return _ENOMEM;
+    memcpy(record->bytes, buffer, len);
+    int err = sp_send_record(fd, record, 0);
+    if (err < 0) sp_record_free(record);
+    return err;
+}
+int_t seqpacket_sendto(struct fd *fd, addr_t buf, dword_t len, int_t flags, addr_t destination, dword_t destination_len) {
+    /* Linux ignores the destination on a connected SEQPACKET socket, but the
+     * syscall must still validate the caller's address buffer. */
+    if (destination) {
+        char ignored[128];
+        if (destination_len > sizeof(ignored)) return _EINVAL;
+        if (user_read(destination, ignored, destination_len)) return _EFAULT;
+    }
+    if (len > SP_MAX_PACKET) return _EMSGSIZE;
+    struct sp_record *record = sp_record_new(len);
+    if (!record) return _ENOMEM;
+    if (user_read(buf, record->bytes, len)) { sp_record_free(record); return _EFAULT; }
+    int err = sp_send_record(fd, record, flags);
+    if (err < 0) sp_record_free(record);
+    return err;
+}
+int_t seqpacket_recvfrom(struct fd *fd, addr_t buf, dword_t len, int_t flags, addr_t addr, addr_t addrlen) {
+    struct sp_record *record;
+    int err = sp_take_record(fd, flags, &record);
+    if (err || !record) return err;
+    size_t copied = len < record->length ? len : record->length;
+    err = user_write(buf, record->bytes, copied) ? _EFAULT : (int) ((flags & MSG_TRUNC_) ? record->length : copied);
+    if (addr && err >= 0) {
+        struct seqpacket *sp = fd->socket.seqpacket;
+        if (sp->peer_name_len) {
+            int named = seqpacket_name(fd, addr, addrlen, true);
+            if (named) err = named;
+        } else {
+            dword_t zero = 0;
+            if (user_put(addrlen, zero)) err = _EFAULT;
+        }
+    }
+    sp_record_free(record);
+    return err;
+}
+
+static int sp_iov(const struct msghdr_ *msg, struct iovec_ **iov, size_t *length) {
+    if (msg->msg_iovlen > SP_MAX_IOV) return _EMSGSIZE;
+    *iov = calloc(msg->msg_iovlen ? msg->msg_iovlen : 1, sizeof(**iov));
+    if (!*iov) return _ENOMEM;
+    if (user_read(msg->msg_iov, *iov, msg->msg_iovlen * sizeof(**iov))) { free(*iov); return _EFAULT; }
+    *length = 0;
+    for (unsigned i = 0; i < msg->msg_iovlen; i++) {
+        if ((*iov)[i].len > INT_MAX - *length) { free(*iov); return _EMSGSIZE; }
+        *length += (*iov)[i].len;
+    }
+    return 0;
+}
+static int sp_rights(struct sp_record *record, const struct msghdr_ *msg) {
+    if (!msg->msg_controllen) return 0;
+    if (msg->msg_controllen > 4096) return _ENOBUFS;
+    char control[4096];
+    if (user_read(msg->msg_control, control, msg->msg_controllen)) return _EFAULT;
+    size_t pos = 0;
+    while (pos + sizeof(struct cmsghdr_) <= msg->msg_controllen) {
+        struct cmsghdr_ *c = (void *) (control + pos);
+        if (c->len < sizeof(*c) || c->len > msg->msg_controllen - pos) return _EINVAL;
+        if (c->level != SOL_SOCKET_) return _EINVAL;
+        if (c->type == SCM_RIGHTS_) {
+            unsigned num = (c->len - sizeof(*c)) / sizeof(fd_t);
+            if ((c->len - sizeof(*c)) % sizeof(fd_t) || num > SP_MAX_RIGHTS - record->num_rights) return _EINVAL;
+            lock(&current->files->lock);
+            for (unsigned i = 0; i < num; i++) {
+                fd_t f; memcpy(&f, c->data + i * sizeof(f), sizeof(f));
+                struct fd *right = fdtable_get(current->files, f);
+                if (!right) { unlock(&current->files->lock); return _EBADF; }
+                /* There is no in-flight UNIX socket cycle collector yet. Do not
+                 * create uncollectable cycles, including cycles through older socket types. */
+                if (S_ISSOCK(right->stat.mode)) { unlock(&current->files->lock); return _EOPNOTSUPP; }
+                record->rights[record->num_rights++] = fd_retain(right);
+            }
+            unlock(&current->files->lock);
+        } else if (c->type == SP_CREDENTIALS) {
+            if (c->len != sizeof(*c) + sizeof(struct ucred_)) return _EINVAL;
+            struct ucred_ cred; memcpy(&cred, c->data, sizeof(cred));
+            if (memcmp(&cred, &record->cred, sizeof(cred))) return _EPERM;
+        } else return _EINVAL;
+        pos += (c->len + 3) & ~3u;
+    }
+    return 0;
+}
+int_t seqpacket_sendmsg(struct fd *fd, addr_t addr, int_t flags) {
+    struct msghdr_ msg;
+    if (user_get(addr, msg)) return _EFAULT;
+    if (msg.msg_name) {
+        char ignored[128];
+        if (msg.msg_namelen > sizeof(ignored)) return _EINVAL;
+        if (user_read(msg.msg_name, ignored, msg.msg_namelen)) return _EFAULT;
+    }
+    struct iovec_ *iov; size_t len;
+    int err = sp_iov(&msg, &iov, &len);
+    if (err) return err;
+    if (len > SP_MAX_PACKET) { free(iov); return _EMSGSIZE; }
+    struct sp_record *record = sp_record_new(len);
+    if (!record) { free(iov); return _ENOMEM; }
+    size_t offset = 0;
+    for (unsigned i = 0; i < msg.msg_iovlen; i++) {
+        if (user_read(iov[i].base, record->bytes + offset, iov[i].len)) { err = _EFAULT; break; }
+        offset += iov[i].len;
+    }
+    free(iov);
+    if (!err) err = sp_rights(record, &msg);
+    if (!err) err = sp_send_record(fd, record, flags);
+    if (err < 0) sp_record_free(record);
+    return err;
+}
+static int sp_control(struct fd *fd, struct sp_record *record, struct msghdr_ *msg, int flags) {
+    unsigned capacity = msg->msg_control ? msg->msg_controllen : 0;
+    char control[2048] = {0};
+    unsigned used = 0;
+    fd_t installed[SP_MAX_RIGHTS]; unsigned count = 0;
+    lock(&sp_lock);
+    bool passcred = fd->socket.seqpacket->passcred;
+    unlock(&sp_lock);
+    if (passcred) {
+        unsigned size = sizeof(struct cmsghdr_) + sizeof(record->cred);
+        if (capacity >= sizeof(struct cmsghdr_)) {
+            unsigned copied = capacity < size ? capacity : size;
+            struct cmsghdr_ *c = (void *) control;
+            c->len = copied; c->level = SOL_SOCKET_; c->type = SP_CREDENTIALS;
+            memcpy(c->data, &record->cred, copied - sizeof(*c));
+            used = (copied + 3) & ~3u;
+            if (used > capacity) used = capacity;
+        }
+        if (capacity < size) msg->msg_flags |= MSG_CTRUNC_;
+    }
+    if (record->num_rights) {
+        unsigned room = capacity > used ? capacity - used : 0;
+        unsigned num = room >= sizeof(struct cmsghdr_) ? (room - sizeof(struct cmsghdr_)) / sizeof(fd_t) : 0;
+        if (num > record->num_rights) num = record->num_rights;
+        struct cmsghdr_ *c = (void *) (control + used);
+        for (unsigned i = 0; i < num; i++) {
+            fd_t f = f_install(record->rights[i], (flags & SP_CMSG_CLOEXEC) ? O_CLOEXEC_ : 0);
+            record->rights[i] = NULL;
+            if (f < 0) break;
+            installed[count++] = f;
+        }
+        if (count) {
+            c->len = sizeof(*c) + count * sizeof(fd_t);
+            c->level = SOL_SOCKET_; c->type = SCM_RIGHTS_;
+            memcpy(c->data, installed, count * sizeof(fd_t));
+            used += c->len;
+        }
+        if (count < record->num_rights) msg->msg_flags |= MSG_CTRUNC_;
+    }
+    if (user_write(msg->msg_control, control, used)) {
+        for (unsigned i = 0; i < count; i++) f_close(installed[i]);
+        return _EFAULT;
+    }
+    msg->msg_controllen = used;
+    return 0;
+}
+int_t seqpacket_recvmsg(struct fd *fd, addr_t addr, int_t flags) {
+    struct msghdr_ msg;
+    if (user_get(addr, msg)) return _EFAULT;
+    struct iovec_ *iov; size_t length;
+    int err = sp_iov(&msg, &iov, &length);
+    if (err) return err;
+    struct sp_record *record;
+    err = sp_take_record(fd, flags, &record);
+    msg.msg_flags = 0;
+    if (err || !record) {
+        free(iov);
+        if (err) return err;
+        msg.msg_controllen = 0;
+        return user_put(addr, msg) ? _EFAULT : 0;
+    }
+    size_t copied = length < record->length ? length : record->length;
+    size_t offset = 0;
+    for (unsigned i = 0; i < msg.msg_iovlen && offset < copied; i++) {
+        size_t part = iov[i].len < copied - offset ? iov[i].len : copied - offset;
+        if (user_write(iov[i].base, record->bytes + offset, part)) { err = _EFAULT; break; }
+        offset += part;
+    }
+    free(iov);
+    if (copied < record->length) msg.msg_flags |= MSG_TRUNC_;
+    if (!err && msg.msg_name) {
+        struct sp_name name = { .family = AF_LOCAL_ };
+        struct seqpacket *sp = fd->socket.seqpacket;
+        memcpy(name.bytes, sp->peer_name, sp->peer_name_len);
+        unsigned actual = sp->peer_name_len ? 2 + sp->peer_name_len : 0;
+        if (user_write(msg.msg_name, &name, msg.msg_namelen < actual ? msg.msg_namelen : actual)) err = _EFAULT;
+        msg.msg_namelen = actual;
+    } else if (!msg.msg_name) msg.msg_namelen = 0;
+    if (!err) err = sp_control(fd, record, &msg, flags);
+    int result = (flags & MSG_TRUNC_) ? record->length : copied;
+    sp_record_free(record);
+    if (err) return err;
+    return user_put(addr, msg) ? _EFAULT : result;
+}
+
+int_t seqpacket_shutdown(struct fd *fd, int_t how) {
+    if (how < 0 || how > 2) return _EINVAL;
+    struct seqpacket *sp = fd->socket.seqpacket;
+    lock(&sp_lock);
+    if (!sp->connected && !sp->listening) { unlock(&sp_lock); return _ENOTCONN; }
+    if (how == 0 || how == 2) sp->read_shutdown = true;
+    if (how == 1 || how == 2) sp->write_shutdown = true;
+    sp_update(fd); if (sp->peer) sp_update(sp->peer);
+    notify(&sp_changed);
+    unlock(&sp_lock);
+    return 0;
+}
+int_t seqpacket_setsockopt(struct fd *fd, int level, int option, addr_t addr, uint_t len) {
+    if (level != SOL_SOCKET_) return _EOPNOTSUPP;
+    if (option == SO_RCVTIMEO_ || option == SO_SNDTIMEO_ ||
+            option == SP_RCVTIMEO_OLD || option == SP_SNDTIMEO_OLD) {
+        int64_t seconds, micros;
+        if (option == SP_RCVTIMEO_OLD || option == SP_SNDTIMEO_OLD) {
+            struct { int32_t seconds, micros; } tv;
+            if (len < sizeof(tv)) return _EINVAL;
+            if (user_get(addr, tv)) return _EFAULT;
+            seconds = tv.seconds; micros = tv.micros;
+        } else {
+            struct { int64_t seconds, micros; } tv;
+            if (len < sizeof(tv)) return _EINVAL;
+            if (user_get(addr, tv)) return _EFAULT;
+            seconds = tv.seconds; micros = tv.micros;
+        }
+        if (seconds < 0 || seconds > INT_MAX || micros < 0 || micros >= 1000000) return _EDOM;
+        struct timespec timeout = { seconds, micros * 1000 };
+        lock(&sp_lock);
+        if (option == SO_RCVTIMEO_ || option == SP_RCVTIMEO_OLD)
+            fd->socket.seqpacket->receive_timeout = timeout;
+        else fd->socket.seqpacket->send_timeout = timeout;
+        unlock(&sp_lock);
+        return 0;
+    }
+    if (len < sizeof(int_t)) return _EINVAL;
+    int_t value;
+    if (user_get(addr, value)) return _EFAULT;
+    struct seqpacket *sp = fd->socket.seqpacket;
+    lock(&sp_lock);
+    int err = 0;
+    if (option == SP_PASSCRED) sp->passcred = value != 0;
+    else if (option == SO_SNDBUF_ || option == SO_RCVBUF_) {
+        unsigned size = value < 0 || value > SP_MAX_PACKET ? SP_MAX_PACKET : value;
+        size *= 2;
+        if (size < 4608) size = 4608;
+        if (option == SO_SNDBUF_) sp->sndbuf = size; else sp->rcvbuf = size;
+        sp_update(fd);
+    } else err = _ENOPROTOOPT;
+    unlock(&sp_lock);
+    return err;
+}
+int_t seqpacket_getsockopt(struct fd *fd, int level, int option, addr_t addr, addr_t len_addr) {
+    if (level != SOL_SOCKET_) return _EOPNOTSUPP;
+    unsigned capacity;
+    if (user_get(len_addr, capacity)) return _EFAULT;
+    struct seqpacket *sp = fd->socket.seqpacket;
+    int value; const void *data = &value; unsigned size = sizeof(value);
+    int64_t time64[2]; int32_t time32[2];
+    lock(&sp_lock);
+    switch (option) {
+        case SO_TYPE_: value = SOCK_SEQPACKET_; break;
+        case SO_DOMAIN_: value = AF_LOCAL_; break;
+        case SO_PROTOCOL_: value = 0; break;
+        case SO_ERROR_: value = -sp->pending_error; sp->pending_error = 0; sp_update(fd); break;
+        case SO_PEERCRED_: data = &sp->peer_cred; size = sizeof(sp->peer_cred); break;
+        case SO_SNDBUF_: value = sp->sndbuf; break;
+        case SO_RCVBUF_: value = sp->rcvbuf; break;
+        case SP_ACCEPTCONN: value = sp->listening; break;
+        case SP_PASSCRED: value = sp->passcred; break;
+        case SO_RCVTIMEO_: case SO_SNDTIMEO_:
+        case SP_RCVTIMEO_OLD: case SP_SNDTIMEO_OLD: {
+            struct timespec tv = option == SO_RCVTIMEO_ || option == SP_RCVTIMEO_OLD ?
+                sp->receive_timeout : sp->send_timeout;
+            if (option == SP_RCVTIMEO_OLD || option == SP_SNDTIMEO_OLD) {
+                time32[0] = tv.tv_sec; time32[1] = tv.tv_nsec / 1000;
+                data = time32; size = sizeof(time32);
+            } else {
+                time64[0] = tv.tv_sec; time64[1] = tv.tv_nsec / 1000;
+                data = time64; size = sizeof(time64);
+            }
+            break;
+        }
+        default: unlock(&sp_lock); return _ENOPROTOOPT;
+    }
+    if (capacity < size) size = capacity;
+    int err = user_write(addr, data, size) || user_put(len_addr, size) ? _EFAULT : 0;
+    unlock(&sp_lock);
+    return err;
+}
+static int sp_poll(struct fd *fd) { return atomic_load(&fd->socket.seqpacket->readiness); }
+static int sp_close(struct fd *fd) {
+    struct seqpacket *sp = fd->socket.seqpacket;
+    lock(&sp_lock);
+    if (sp->bound) list_remove(&sp->bound_link);
+    notify(&sp_changed);
+    if (sp->peer) {
+        struct fd *peer = sp->peer;
+        if (!list_empty(&sp->records)) peer->socket.seqpacket->pending_error = _ECONNRESET;
+        peer->socket.seqpacket->peer = NULL;
+        sp->peer = NULL;
+        sp_update(peer);
+    }
+    /* No reference destructors run under sp_lock: a passed descriptor can have
+     * arbitrary close operations, and pending sockets also acquire this lock. */
+    unlock(&sp_lock);
+    struct sp_record *record, *tmp;
+    list_for_each_entry_safe(&sp->records, record, tmp, link) {
+        list_remove(&record->link); sp_record_free(record);
+    }
+    struct seqpacket *pending, *next;
+    list_for_each_entry_safe(&sp->pending, pending, next, pending_link) {
+        list_remove(&pending->pending_link); fd_close(pending->owner);
+    }
+    sock_unix_release_name(fd);
+    free(sp);
+    return 0;
+}
+static ssize_t sp_ioctl_size(int cmd) { return cmd == SP_FIONREAD ? sizeof(int_t) : -1; }
+static int sp_ioctl(struct fd *fd, int cmd, void *arg) {
+    if (cmd != SP_FIONREAD) return _ENOTTY;
+    struct seqpacket *sp = fd->socket.seqpacket;
+    lock(&sp_lock);
+    if (sp->listening) { unlock(&sp_lock); return _EINVAL; }
+    size_t bytes = 0;
+    struct sp_record *record;
+    list_for_each_entry(&sp->records, record, link) bytes += record->length;
+    *(int_t *) arg = bytes > INT_MAX ? INT_MAX : bytes;
+    unlock(&sp_lock);
+    return 0;
+}
+static off_t_ sp_lseek(struct fd *fd, off_t offset, int whence) {
+    (void) fd; (void) offset; (void) whence;
+    return _ESPIPE;
+}
+const struct fd_ops seqpacket_fdops = {
+    .read = sp_read, .write = sp_write, .close = sp_close, .poll = sp_poll,
+    .ioctl_size = sp_ioctl_size, .ioctl = sp_ioctl, .lseek = sp_lseek,
+};
