+/// iSH compatibility allocator. libc supplies the required page alignment;
+/// unlike mmap-backed pages, the returned storage must be cleared explicitly.
+const AllocLibC = struct {
+    pub fn alloc(n: usize) ![]align(std.heap.page_size_min) u8 {
+        const mem = try std.heap.c_allocator.alignedAlloc(
+            u8,
+            .fromByteUnits(std.heap.page_size_min),
+            n,
+        );
+        @memset(mem, 0);
+        return mem;
+    }
+
+    pub fn free(mem: []align(std.heap.page_size_min) u8) void {
+        std.heap.c_allocator.free(mem);
+    }
 };
 
