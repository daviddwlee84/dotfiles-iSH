diff --git a/vendor/libghostty-vt/src/terminal/c/abi_i386.c b/vendor/libghostty-vt/src/terminal/c/abi_i386.c
new file mode 100644
index 0000000..a6ca900
--- /dev/null
+++ b/vendor/libghostty-vt/src/terminal/c/abi_i386.c
@@ -0,0 +1,50 @@
+/* Scoped workaround for Zig 0.15.2 i386/Linux by-value aggregate lowering.
+ * Clang receives the unchanged public C ABI, then passes the local aggregate
+ * by pointer to a distinct, correctly typed Zig C entry. No function aliases
+ * or caller-side casts change the declared ABI. Other targets do not build it.
+ */
+#include <ghostty/vt.h>
+
+#if !defined(__i386__) || !defined(__linux__)
+#error "The i386 C ABI bridge is only for 32-bit x86 Linux"
+#endif
+
+extern GhosttyResult ghostty_i386_terminal_new_indirect(
+    const GhosttyAllocator *, GhosttyTerminal *, const GhosttyTerminalOptions *);
+extern GhosttyResult ghostty_i386_formatter_terminal_new_indirect(
+    const GhosttyAllocator *, GhosttyFormatter *, GhosttyTerminal,
+    const GhosttyFormatterTerminalOptions *);
+extern void ghostty_i386_terminal_scroll_viewport_indirect(
+    GhosttyTerminal, const GhosttyTerminalScrollViewport *);
+extern GhosttyResult ghostty_i386_terminal_grid_ref_indirect(
+    GhosttyTerminal, const GhosttyPoint *, GhosttyGridRef *);
+extern void ghostty_i386_mouse_event_set_position_indirect(
+    GhosttyMouseEvent, const GhosttyMousePosition *);
+
+GHOSTTY_API GhosttyResult ghostty_terminal_new(
+    const GhosttyAllocator *allocator, GhosttyTerminal *terminal,
+    GhosttyTerminalOptions options) {
+    return ghostty_i386_terminal_new_indirect(allocator, terminal, &options);
+}
+
+GHOSTTY_API GhosttyResult ghostty_formatter_terminal_new(
+    const GhosttyAllocator *allocator, GhosttyFormatter *formatter,
+    GhosttyTerminal terminal, GhosttyFormatterTerminalOptions options) {
+    return ghostty_i386_formatter_terminal_new_indirect(
+        allocator, formatter, terminal, &options);
+}
+
+GHOSTTY_API void ghostty_terminal_scroll_viewport(
+    GhosttyTerminal terminal, GhosttyTerminalScrollViewport behavior) {
+    ghostty_i386_terminal_scroll_viewport_indirect(terminal, &behavior);
+}
+
+GHOSTTY_API GhosttyResult ghostty_terminal_grid_ref(
+    GhosttyTerminal terminal, GhosttyPoint point, GhosttyGridRef *out_ref) {
+    return ghostty_i386_terminal_grid_ref_indirect(terminal, &point, out_ref);
+}
+
+GHOSTTY_API void ghostty_mouse_event_set_position(
+    GhosttyMouseEvent event, GhosttyMousePosition position) {
+    ghostty_i386_mouse_event_set_position_indirect(event, &position);
+}
diff --git a/vendor/libghostty-vt/src/terminal/c/abi_i386.zig b/vendor/libghostty-vt/src/terminal/c/abi_i386.zig
new file mode 100644
index 0000000..201b7b2
--- /dev/null
+++ b/vendor/libghostty-vt/src/terminal/c/abi_i386.zig
@@ -0,0 +1,50 @@
+//! Pointer-only C entries paired with abi_i386.c. Public C declarations and
+//! extern struct layouts stay unchanged. This covers five Herdr call paths,
+//! not every aggregate in the complete libghostty C API.
+const lib = @import("../lib.zig");
+const terminal = @import("terminal.zig");
+const formatter = @import("formatter.zig");
+const grid_ref = @import("grid_ref.zig");
+const mouse_event = @import("mouse_event.zig");
+const point = @import("../point.zig");
+const Result = @import("result.zig").Result;
+const CAllocator = lib.alloc.Allocator;
+
+pub fn terminal_new(
+    allocator: ?*const CAllocator,
+    result: *terminal.Terminal,
+    options: *const terminal.Options,
+) callconv(.c) Result {
+    return terminal.new(allocator, result, options.*);
+}
+
+pub fn formatter_terminal_new(
+    allocator: ?*const CAllocator,
+    result: *formatter.Formatter,
+    terminal_: terminal.Terminal,
+    options: *const formatter.TerminalOptions,
+) callconv(.c) Result {
+    return formatter.terminal_new(allocator, result, terminal_, options.*);
+}
+
+pub fn terminal_scroll_viewport(
+    terminal_: terminal.Terminal,
+    behavior: *const terminal.ScrollViewport,
+) callconv(.c) void {
+    terminal.scroll_viewport(terminal_, behavior.*);
+}
+
+pub fn terminal_grid_ref(
+    terminal_: terminal.Terminal,
+    position: *const point.Point.C,
+    out_ref: ?*grid_ref.CGridRef,
+) callconv(.c) Result {
+    return terminal.grid_ref(terminal_, position.*, out_ref);
+}
+
+pub fn mouse_event_set_position(
+    event: mouse_event.Event,
+    position: *const mouse_event.Position,
+) callconv(.c) void {
+    mouse_event.set_position(event, position.*);
+}
